extends SceneTree

## Regenerates docs/input_map.md from the binding tables, so the checklist you enter into
## Project Settings cannot drift from what the game actually polls.
##
##   godot --headless --path . --script res://tools/dump_input_map.gd
##
## Run it after changing ControlProfiles.ACTIONS or InputReader.META.

const OUT := "res://docs/input_map.md"

func _init() -> void:
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	if f == null:
		print("cannot write %s" % OUT)
		quit(1)
		return
	for line in _header():
		f.store_line(line)
	var total := 0
	for grp in _groups():
		f.store_line("## %s" % grp[0])
		f.store_line("")
		f.store_line(grp[1])
		f.store_line("")
		f.store_line("| action | keys | needed |")
		f.store_line("|---|---|---|")
		var table: Dictionary = grp[2]
		for a in grp[3]:
			var parts: Array = []
			for k in table[a]:
				parts.append(OS.get_keycode_string(k))
			var keys := ", ".join(parts) if parts.size() > 0 else "_(declare it, leave it unbound)_"
			if a in ControlProfiles.OPTIONAL:
				f.store_line("| `%s` | %s | optional |" % [a, keys])
			else:
				f.store_line("| `%s` | %s | **required** |" % [a, keys])
				total += 1
		f.store_line("")
	f.store_line("## Already present")
	f.store_line("")
	f.store_line("| action | keys |")
	f.store_line("|---|---|")
	for a in ControlProfiles.EXTERNAL:
		f.store_line("| `%s` | %s — authored by hand, owned by you, never touched by code |"
			% [a, ControlProfiles.keys_text(a)])
	f.store_line("")
	f.store_line("**%d required.** Leaving one of those out makes something unusable: you cannot" % total)
	f.store_line("play without the Tetris actions, cannot recover from a top-out without")
	f.store_line("`restart`, and cannot see what went wrong without `toggle_debug`.")
	f.store_line("")
	f.store_line("Rows marked `optional` cost only their own key. Skip them and F2-F11 simply do")
	f.store_line("nothing, and the suite reports them as a note rather than a failure. Declare them")
	f.store_line("when you want the toggle.")
	f.store_line("")
	f.store_line("`tests/run_tests.tscn` fails with the list of REQUIRED actions still missing, so")
	f.store_line("the suite is the live checklist.")
	f.store_line("")
	f.store_line("<sub>Generated by `tools/dump_input_map.gd` — do not edit by hand.</sub>")
	f.close()
	print("wrote %s: %d actions" % [OUT, total])
	quit()

func _groups() -> Array:
	return [
		["Tetris actions",
		"The eight the sim consumes, via `InputState`. These are the only actions F5 rebinds"
		+ " at runtime, so the keys below are just the default (`wasd_numpad`) profile — the"
		+ " other two overwrite them in place. Declare them with these keys and the code"
		+ " takes it from there.",
		ControlProfiles.get_profile("wasd_numpad"), ControlProfiles.ACTIONS],
		["Meta actions",
		"Fixed everywhere and never rebound, so a profile can never shadow restart or the"
		+ " debug toggles.",
		InputReader.META, InputReader.META.keys()],
	]

func _header() -> Array:
	return [
		"# Input Map — the actions to declare in project.godot",
		"",
		"Every action below must exist in **Project > Project Settings > Input Map**.",
		"Nothing is created at runtime: `ControlProfiles.bind_table` only ever rebinds actions",
		"that already exist, and `InputReader` polls only what the map declares. A missing",
		"action becomes a dead key rather than an error every tick, and",
		"`InputReader.missing_actions()` lists what is not there yet.",
		"",
		"Entries written into `project.godot` by hand do not appear in the editor's Input Map",
		"menu and are overwritten on the next editor save, because the editor holds",
		"ProjectSettings in memory. So this is a checklist for the GUI, not a file to paste.",
		"",
		"## Three things that will bite",
		"",
		"**Use Physical Keycode, not Keycode.** In the Add Event dialog pick the \"Physical",
		"Keycode\" entry for every key. `InputEventKey.action_match` prefers `keycode` whenever",
		"it is non-zero, so a keycode binding silently moves WASD on AZERTY and stops the",
		"numpad working with NumLock off. The existing `switch_board` entry is already correct",
		"(`keycode: 0, physical_keycode: 4194306`) and is the shape to copy.",
		"",
		"**The arrow keys and Space are shared with `ui_*`, and that is fine here.** Godot binds",
		"`ui_left`/`ui_right`/`ui_up`/`ui_down` to the arrows and `ui_accept`/`ui_select` to",
		"Space, so those fire alongside the arrow-key profiles. It only matters when a",
		"`Control` node holds focus, and `main.tscn` has none — every view is a script-only",
		"`Node2D` drawing in `_draw()`. (`replay.tscn` does build real Controls, but nothing",
		"there reads these.) None of the names below collide with a built-in: all 92 of Godot's",
		"are `ui_`-prefixed, and a test enforces that this stays true.",
		"",
		"**Never bind F8.** It is Godot's *Stop Running Project*, and the editor honours it even",
		"while the game has focus, so anything bound there quits instead of firing.",
		"",
	]
